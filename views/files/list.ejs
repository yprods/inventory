<%- include('../layout', { title: 'ניהול קבצים', content: `
<div class="container-fluid mt-4 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold">
            <i class="fas fa-folder-open text-primary"></i> ניהול קבצים
        </h1>
    </div>
    
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
    <% } %>
    
    <% if (files && files.length > 0) { %>
        <div class="card shadow-lg">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>שם קובץ</th>
                                <th>גודל</th>
                                <th>תאריך שינוי</th>
                                <th>פעולות</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% files.forEach(file => { %>
                                <tr>
                                    <td><%= file.name %></td>
                                    <td><%= (file.size / 1024).toFixed(2) %> KB</td>
                                    <td><%= new Date(file.modified).toLocaleString('he-IL') %></td>
                                    <td>
                                        <a href="/uploads/<%= file.name %>" class="btn btn-sm btn-primary" download>
                                            <i class="fas fa-download"></i> הורד
                                        </a>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    <% } else { %>
        <div class="card shadow-lg">
            <div class="card-body text-center py-5">
                <i class="fas fa-folder-open fa-4x text-muted mb-3"></i>
                <h4>אין קבצים</h4>
                <p class="text-muted">לא נמצאו קבצים במערכת</p>
            </div>
        </div>
    <% } %>
</div>
` }) %>

