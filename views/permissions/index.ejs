<%- include('../layout', { title: 'ניהול הרשאות', content: `
<div class="container-fluid mt-4 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold">
            <i class="fas fa-shield-alt text-primary"></i> ניהול הרשאות
        </h1>
    </div>
    
    <div class="row">
        <!-- Users List -->
        <div class="col-md-8">
            <div class="card shadow-lg mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-users"></i> משתמשים</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>שם משתמש</th>
                                    <th>שם תצוגה</th>
                                    <th>מחלקה</th>
                                    <th>תפקידים</th>
                                    <th>פעולות</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% users.forEach(u => { %>
                                    <tr>
                                        <td><strong><%= u.Username %></strong></td>
                                        <td><%= u.DisplayName || u.Username %></td>
                                        <td><%= u.Department || '-' %></td>
                                        <td>
                                            <% const userRoles = Array.isArray(u.Roles) ? u.Roles : []; %>
                                            <% userRoles.forEach(roleId => { %>
                                                <% const role = roles.find(r => r.Id === roleId); %>
                                                <% if (role) { %>
                                                    <span class="badge bg-primary"><%= role.Name %></span>
                                                <% } %>
                                            <% }); %>
                                        </td>
                                        <td>
                                            <a href="/permissions/user/<%= encodeURIComponent(u.Username) %>" class="btn btn-sm btn-primary">
                                                <i class="fas fa-edit"></i> ערוך
                                            </a>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Roles List -->
        <div class="col-md-4">
            <div class="card shadow-lg">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-user-tag"></i> תפקידים</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group">
                        <% roles.forEach(role => { %>
                            <li class="list-group-item">
                                <strong><%= role.Name %></strong>
                                <p class="text-muted mb-0 small"><%= role.Description || '' %></p>
                            </li>
                        <% }); %>
                    </ul>
                    
                    <button class="btn btn-success w-100 mt-3" data-bs-toggle="modal" data-bs-target="#createRoleModal">
                        <i class="fas fa-plus"></i> צור תפקיד חדש
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create Role Modal -->
<div class="modal fade" id="createRoleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-plus"></i> צור תפקיד חדש</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="createRoleForm">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">שם התפקיד</label>
                        <input type="text" name="name" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">תיאור</label>
                        <textarea name="description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">הרשאות (מופרדות בפסיק)</label>
                        <input type="text" name="permissions" class="form-control" placeholder="computers.*, printers.view, ...">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ביטול</button>
                    <button type="submit" class="btn btn-primary">צור</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
document.getElementById('createRoleForm')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const formData = new FormData(this);
    const permissions = formData.get('permissions').split(',').map(p => p.trim()).filter(p => p);
    
    try {
        const response = await fetch('/permissions/roles/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                name: formData.get('name'),
                description: formData.get('description'),
                permissions: permissions
            })
        });
        
        const data = await response.json();
        if (data.success) {
            alert('התפקיד נוצר בהצלחה!');
            location.reload();
        } else {
            alert('שגיאה: ' + (data.error || 'Unknown error'));
        }
    } catch (error) {
        console.error('Create role error:', error);
        alert('שגיאה ביצירת התפקיד');
    }
});
</script>
` }) %>

