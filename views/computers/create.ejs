<%- include('../layout', { title: 'יצירת מחשב חדש', content: `
<div class="container mt-4 fade-in">
    <h1 class="display-5 fw-bold mb-4">
        <i class="fas fa-desktop text-primary"></i> יצירת מחשב חדש
    </h1>
    
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
    <% } %>
    
    <div class="card shadow-lg">
        <div class="card-body p-4">
            <form method="POST" action="/computers/create">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><i class="fas fa-tag"></i> שם המחשב *</label>
                        <input type="text" name="name" class="form-control" required autofocus>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><i class="fas fa-info-circle"></i> דגם</label>
                        <input type="text" name="model" class="form-control">
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><i class="fas fa-laptop-code"></i> מערכת הפעלה</label>
                        <input type="text" name="os" class="form-control" placeholder="Windows 10, Linux...">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><i class="fas fa-info-circle"></i> סטטוס</label>
                        <select name="status" class="form-control">
                            <option value="Active">פעיל</option>
                            <option value="Inactive">לא פעיל</option>
                            <option value="Maintenance">תחזוקה</option>
                        </select>
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><i class="fas fa-microchip"></i> מעבד (CPU)</label>
                        <input type="text" name="cpu" class="form-control" placeholder="Intel i5, AMD Ryzen...">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><i class="fas fa-memory"></i> זיכרון (RAM)</label>
                        <input type="text" name="ram" class="form-control" placeholder="8GB, 16GB...">
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><i class="fas fa-hdd"></i> דיסק קשיח (HDD)</label>
                        <input type="text" name="hdd" class="form-control" placeholder="500GB, 1TB...">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><i class="fas fa-network-wired"></i> כתובת IP</label>
                        <input type="text" name="ip" class="form-control" placeholder="192.168.1.100">
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><i class="fas fa-map-marker-alt"></i> מיקום</label>
                        <input type="text" name="location" class="form-control">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><i class="fas fa-user"></i> משתמש מוקצה</label>
                        <input type="text" name="user" class="form-control">
                    </div>
                </div>
                
                <div class="mb-3">
                    <label class="form-label"><i class="fas fa-align-right"></i> תיאור</label>
                    <textarea name="description" class="form-control" rows="4"></textarea>
                </div>
                
                <div class="mt-4">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="fas fa-save"></i> שמור מחשב
                    </button>
                    <a href="/computers" class="btn btn-secondary btn-lg">ביטול</a>
                </div>
            </form>
        </div>
    </div>
</div>
` }) %>

