<%- include('../layout', { title: 'מחשבים', content: `
<div class="container-fluid mt-4 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold">
            <i class="fas fa-desktop text-primary"></i> מחשבים
        </h1>
        <a href="/computers/create" class="btn btn-primary btn-lg">
            <i class="fas fa-plus-circle"></i> הוסף מחשב חדש
        </a>
    </div>
    
    <!-- Search and Filters -->
    <div class="card shadow-md mb-4">
        <div class="card-body">
            <form method="GET" action="/computers" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label"><i class="fas fa-search"></i> חיפוש</label>
                    <input type="text" name="search" class="form-control" value="<%= search %>" placeholder="חפש מחשב...">
                </div>
                <div class="col-md-2">
                    <label class="form-label"><i class="fas fa-info-circle"></i> סטטוס</label>
                    <select name="status" class="form-control">
                        <option value="">הכל</option>
                        <option value="Active" <%= status === 'Active' ? 'selected' : '' %>>פעיל</option>
                        <option value="Inactive" <%= status === 'Inactive' ? 'selected' : '' %>>לא פעיל</option>
                        <option value="Maintenance" <%= status === 'Maintenance' ? 'selected' : '' %>>תחזוקה</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label"><i class="fas fa-laptop-code"></i> מערכת הפעלה</label>
                    <input type="text" name="os" class="form-control" value="<%= os %>" placeholder="Windows, Linux...">
                </div>
                <div class="col-md-3">
                    <label class="form-label"><i class="fas fa-map-marker-alt"></i> מיקום</label>
                    <input type="text" name="location" class="form-control" value="<%= location %>" placeholder="מיקום...">
                </div>
                <div class="col-md-2">
                    <label class="form-label">&nbsp;</label>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search"></i> חפש
                    </button>
                </div>
            </form>
        </div>
    </div>
    
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
    <% } %>
    
    <!-- Computers Grid -->
    <% if (computers && computers.length > 0) { %>
        <div class="row g-4">
            <% computers.forEach(computer => { %>
                <div class="col-md-4">
                    <div class="card shadow-md h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="card-title fw-bold">
                                        <i class="fas fa-desktop text-primary"></i> <%= computer.Name || computer.name || computer.f0 || 'ללא שם' %>
                                    </h5>
                                    <p class="text-muted mb-0">
                                        <i class="fas fa-laptop-code"></i> <%= computer.f3 || 'ללא מערכת הפעלה' %>
                                    </p>
                                </div>
                                <span class="badge bg-<%= computer.f1 === 'Active' ? 'success' : computer.f1 === 'Maintenance' ? 'warning' : 'secondary' %>">
                                    <%= computer.f1 || 'Unknown' %>
                                </span>
                            </div>
                            
                            <div class="mb-3">
                                <% if (computer.f4) { %>
                                    <p class="mb-1"><i class="fas fa-microchip text-muted"></i> CPU: <%= computer.f4 %></p>
                                <% } %>
                                <% if (computer.f5) { %>
                                    <p class="mb-1"><i class="fas fa-memory text-muted"></i> RAM: <%= computer.f5 %></p>
                                <% } %>
                                <% if (computer.f2) { %>
                                    <p class="mb-1"><i class="fas fa-map-marker-alt text-muted"></i> <%= computer.f2 %></p>
                                <% } %>
                                <% if (computer.f9) { %>
                                    <p class="mb-1"><i class="fas fa-user text-muted"></i> <%= computer.f9 %></p>
                                <% } %>
                            </div>
                            
                            <a href="/computers/<%= encodeURIComponent(computer.Name || computer.name || computer.CI_ID) %>" class="btn btn-outline-primary w-100">
                                <i class="fas fa-eye"></i> צפה בפרטים
                            </a>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } else { %>
        <div class="card shadow-md">
            <div class="card-body text-center py-5">
                <i class="fas fa-desktop fa-4x text-muted mb-3"></i>
                <h4>אין מחשבים</h4>
                <p class="text-muted">לא נמצאו מחשבים במערכת</p>
                <a href="/computers/create" class="btn btn-primary">
                    <i class="fas fa-plus"></i> הוסף מחשב ראשון
                </a>
            </div>
        </div>
    <% } %>
</div>
` }) %>

