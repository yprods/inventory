<%- include('../layout', { title: 'מחשבים', content: `
<div class="container-fluid mt-4 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold">
            <i class="fas fa-desktop text-primary"></i> מחשבים
        </h1>
    </div>
    
    <div class="card shadow-md mb-4">
        <div class="card-body">
            <form method="GET" action="/computers" class="d-flex gap-2">
                <input type="text" name="search" class="form-control" value="<%= search %>" placeholder="חפש מחשב...">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-search"></i> חפש
                </button>
            </form>
        </div>
    </div>
    
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
    <% } %>
    
    <% if (computers && computers.length > 0) { %>
        <div class="card shadow-lg">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>שם</th>
                                <th>מיקום</th>
                                <th>IP</th>
                                <th>מערכת הפעלה</th>
                                <th>פעולות</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% computers.forEach(computer => { %>
                                <tr>
                                    <td><strong><%= computer.Name || computer.name || computer.f0 || '-' %></strong></td>
                                    <td><%= computer.f2 || '-' %></td>
                                    <td><%= computer.f3 || '-' %></td>
                                    <td><%= computer.f1 || '-' %></td>
                                    <td>
                                        <a href="/datablocks?search=<%= encodeURIComponent(computer.Name || computer.name) %>" class="btn btn-sm btn-primary">
                                            <i class="fas fa-eye"></i> צפה
                                        </a>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    <% } else { %>
        <div class="card shadow-lg">
            <div class="card-body text-center py-5">
                <i class="fas fa-desktop fa-4x text-muted mb-3"></i>
                <h4>אין מחשבים</h4>
                <p class="text-muted">לא נמצאו מחשבים במערכת</p>
            </div>
        </div>
    <% } %>
</div>
` }) %>

