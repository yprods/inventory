<%- include('../layout', { title: `קשרים - ${item?.Name || 'Unknown'}`, content: `
<div class="container mt-4 fade-in">
    <h1 class="display-5 fw-bold mb-4">
        <i class="fas fa-link text-primary"></i> קשרים - <%= item?.Name || 'Unknown' %>
    </h1>
    
    <div class="card shadow-lg">
        <div class="card-body">
            <% if (item) { %>
                <a href="/datablocks?search=<%= encodeURIComponent(item.Name || item.CI_ID) %>" class="btn btn-primary">
                    <i class="fas fa-eye"></i> צפה בפרטי הפריט
                </a>
            <% } else { %>
                <p class="text-muted">פריט לא נמצא</p>
            <% } %>
        </div>
    </div>
</div>
` }) %>

