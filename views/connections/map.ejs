<%- include('../layout', { title: 'מפת קשרים', content: `
<div class="container-fluid mt-4 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold">
            <i class="fas fa-project-diagram text-primary"></i> מפת קשרים
        </h1>
    </div>
    
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
    <% } %>
    
    <div class="card shadow-lg">
        <div class="card-body">
            <% if (items && items.length > 0) { %>
                <div class="row g-3">
                    <% items.forEach(item => { %>
                        <div class="col-md-3">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h6><%= item.Name || item.CI_ID || '-' %></h6>
                                    <a href="/datablocks?search=<%= encodeURIComponent(item.Name || item.CI_ID) %>" class="btn btn-sm btn-primary">
                                        <i class="fas fa-eye"></i> צפה
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <p class="text-muted text-center">אין פריטים להצגה</p>
            <% } %>
        </div>
    </div>
</div>
` }) %>

