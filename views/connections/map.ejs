<%- include('../layout', { title: 'מפת קשרים', content: `
<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-project-diagram"></i> מפת קשרים</h1>
        <div>
            <input type="text" id="itemFilter" class="form-control d-inline-block" style="width: 300px;" placeholder="סנן לפי פריט...">
            <button class="btn btn-primary" onclick="loadConnectionMap()">
                <i class="fas fa-sync"></i> רענן
            </button>
        </div>
    </div>
    
    <div class="card">
        <div class="card-body">
            <div id="connectionMap" style="height: 600px; border: 1px solid #ddd; border-radius: 4px;"></div>
        </div>
    </div>
    
    <div class="mt-4">
        <h3>סטטיסטיקות</h3>
        <div class="row">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h5>סה"כ פריטים</h5>
                        <h2 id="totalNodes">0</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h5>סה"כ קשרים</h5>
                        <h2 id="totalEdges">0</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h5>פריטים נבחרים</h5>
                        <h2 id="selectedNodes">0</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://unpkg.com/vis-network@latest/dist/vis-network.min.js"></script>
<link rel="stylesheet" href="https://unpkg.com/vis-network@latest/dist/vis-network.min.css">
<script src="/js/connectionMap.js"></script>
` }) %>

