<%- include('../layout', { title: 'יצירת פריט חדש', content: `
<div class="container mt-4 fade-in">
    <h1 class="display-5 fw-bold mb-4">
        <i class="fas fa-plus-circle text-primary"></i> יצירת פריט חדש
    </h1>
    
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
    <% } %>
    
    <div class="card shadow-lg">
        <div class="card-body p-4">
            <form method="POST" action="/create">
                <div class="mb-3">
                    <label class="form-label"><i class="fas fa-tag"></i> שם הפריט *</label>
                    <input type="text" name="search" class="form-control" value="<%= search || '' %>" required autofocus>
                </div>
                
                <div class="mb-3">
                    <label class="form-label"><i class="fas fa-folder"></i> סוג פריט</label>
                    <input type="text" name="itemType" class="form-control" placeholder="Computer, Printer, etc.">
                </div>
                
                <h5 class="mt-4 mb-3">שדות נוספים (f0-f50)</h5>
                <div class="row">
                    <% for (let i = 0; i <= 10; i++) { %>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">f<%= i %></label>
                            <input type="text" name="f<%= i %>" class="form-control">
                        </div>
                    <% } %>
                </div>
                
                <div class="mt-4">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="fas fa-save"></i> שמור פריט
                    </button>
                    <a href="/home" class="btn btn-secondary btn-lg">ביטול</a>
                </div>
            </form>
        </div>
    </div>
</div>
` }) %>

