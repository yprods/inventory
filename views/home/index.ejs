<%- include('../layout', { title: 'דף הבית', content: `
<div class="container mt-4 fade-in">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold mb-3">
            <i class="fas fa-book-open text-primary"></i> ברוך הבא לספר מערכת
        </h1>
        <p class="lead text-muted">מערכת ניהול מרכזית מתקדמת</p>
    </div>
    
    <% if (successMessage) { %>
        <div class="alert alert-success alert-dismissible fade show">
            <%= successMessage %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    
    <% if (errorMessage) { %>
        <div class="alert alert-danger alert-dismissible fade show">
            <%= errorMessage %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    
    <div class="row g-4 mt-4">
        <div class="col-md-6">
            <div class="card h-100 shadow-lg">
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <i class="fas fa-search fa-3x text-primary"></i>
                    </div>
                    <h4 class="card-title fw-bold mb-3">חיפוש במערכת</h4>
                    <p class="text-muted mb-4">חפש פריטים במערכת</p>
                    <form action="/datablocks" method="GET" class="mb-3">
                        <div class="input-group">
                            <input type="text" name="search" class="form-control" placeholder="הקלד לחיפוש..." required>
                            <button class="btn btn-primary" type="submit">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card h-100 shadow-lg">
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <i class="fas fa-plus-circle fa-3x text-success"></i>
                    </div>
                    <h4 class="card-title fw-bold mb-3">יצירת פריט</h4>
                    <p class="text-muted mb-4">צור פריט חדש במערכת</p>
                    <a href="/create" class="btn btn-success w-100">
                        <i class="fas fa-plus"></i> צור פריט חדש
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
` }) %>

