<%- include('../layout', { title: 'הוספת איש קשר', content: `
<div class="container mt-4 fade-in">
    <h1 class="display-5 fw-bold mb-4">
        <i class="fas fa-address-book text-primary"></i> הוספת איש קשר
    </h1>
    
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
    <% } %>
    
    <div class="card shadow-lg">
        <div class="card-body p-4">
            <form method="POST" action="/phonebook/create">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><i class="fas fa-user"></i> שם איש הקשר *</label>
                        <input type="text" name="name" class="form-control" required autofocus>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><i class="fas fa-folder"></i> קטגוריה</label>
                        <input type="text" name="category" class="form-control" placeholder="עובד, לקוח, ספק...">
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><i class="fas fa-phone"></i> טלפון</label>
                        <input type="tel" name="phone" class="form-control" placeholder="02-1234567">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><i class="fas fa-mobile-alt"></i> נייד</label>
                        <input type="tel" name="mobile" class="form-control" placeholder="050-1234567">
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><i class="fas fa-envelope"></i> אימייל</label>
                        <input type="email" name="email" class="form-control" placeholder="email@example.com">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><i class="fas fa-building"></i> מחלקה</label>
                        <input type="text" name="department" class="form-control" placeholder="IT, HR, Finance...">
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><i class="fas fa-briefcase"></i> תפקיד</label>
                        <input type="text" name="position" class="form-control" placeholder="מנהל, מפתח, אנליסט...">
                    </div>
                </div>
                
                <div class="mb-3">
                    <label class="form-label"><i class="fas fa-align-right"></i> הערות</label>
                    <textarea name="notes" class="form-control" rows="4"></textarea>
                </div>
                
                <div class="mt-4">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="fas fa-save"></i> שמור איש קשר
                    </button>
                    <a href="/phonebook" class="btn btn-secondary btn-lg">ביטול</a>
                </div>
            </form>
        </div>
    </div>
</div>
` }) %>

