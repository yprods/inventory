<%- include('../layout', { title: `איש קשר - ${contact.Name || contact.name}`, content: `
<div class="container mt-4 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold">
            <i class="fas fa-address-book text-primary"></i> <%= contact.Name || contact.name %>
        </h1>
        <div>
            <a href="/phonebook" class="btn btn-secondary">
                <i class="fas fa-arrow-right"></i> חזרה לרשימה
            </a>
        </div>
    </div>
    
    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-lg mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-info-circle"></i> פרטי איש קשר</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong><i class="fas fa-building"></i> מחלקה:</strong>
                            <p><%= contact.f2 || 'לא צוין' %></p>
                        </div>
                        <div class="col-md-6">
                            <strong><i class="fas fa-briefcase"></i> תפקיד:</strong>
                            <p><%= contact.f7 || 'לא צוין' %></p>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong><i class="fas fa-phone"></i> טלפון:</strong>
                            <p>
                                <% if (contact.f3) { %>
                                    <a href="tel:<%= contact.f3 %>" class="btn btn-outline-primary btn-sm">
                                        <i class="fas fa-phone"></i> <%= contact.f3 %>
                                    </a>
                                <% } else { %>
                                    לא צוין
                                <% } %>
                            </p>
                        </div>
                        <div class="col-md-6">
                            <strong><i class="fas fa-mobile-alt"></i> נייד:</strong>
                            <p>
                                <% if (contact.f4) { %>
                                    <a href="tel:<%= contact.f4 %>" class="btn btn-outline-primary btn-sm">
                                        <i class="fas fa-mobile-alt"></i> <%= contact.f4 %>
                                    </a>
                                <% } else { %>
                                    לא צוין
                                <% } %>
                            </p>
                        </div>
                    </div>
                    <div class="mb-3">
                        <strong><i class="fas fa-envelope"></i> אימייל:</strong>
                        <p>
                            <% if (contact.f5) { %>
                                <a href="mailto:<%= contact.f5 %>" class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-envelope"></i> <%= contact.f5 %>
                                </a>
                            <% } else { %>
                                לא צוין
                            <% } %>
                        </p>
                    </div>
                    <% if (contact.f8) { %>
                        <div class="mb-3">
                            <strong><i class="fas fa-align-right"></i> הערות:</strong>
                            <p><%= contact.f8 %></p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card shadow-md mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-cog"></i> פעולות</h5>
                </div>
                <div class="card-body">
                    <button class="btn btn-primary w-100 mb-2" data-bs-toggle="modal" data-bs-target="#editModal">
                        <i class="fas fa-edit"></i> ערוך
                    </button>
                    <button class="btn btn-danger w-100" onclick="deleteContact('<%= contact.Name || contact.name %>')">
                        <i class="fas fa-trash"></i> מחק
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-edit"></i> ערוך איש קשר</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="POST" action="/phonebook/<%= encodeURIComponent(contact.Name || contact.name) %>/update">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">קטגוריה</label>
                        <input type="text" name="category" class="form-control" value="<%= contact.f1 || '' %>">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">מחלקה</label>
                        <input type="text" name="department" class="form-control" value="<%= contact.f2 || '' %>">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">טלפון</label>
                        <input type="tel" name="phone" class="form-control" value="<%= contact.f3 || '' %>">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">נייד</label>
                        <input type="tel" name="mobile" class="form-control" value="<%= contact.f4 || '' %>">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">אימייל</label>
                        <input type="email" name="email" class="form-control" value="<%= contact.f5 || '' %>">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">תפקיד</label>
                        <input type="text" name="position" class="form-control" value="<%= contact.f7 || '' %>">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">הערות</label>
                        <textarea name="notes" class="form-control" rows="3"><%= contact.f8 || '' %></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ביטול</button>
                    <button type="submit" class="btn btn-primary">שמור</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function deleteContact(name) {
    if (confirm('האם אתה בטוח שברצונך למחוק את איש הקשר?')) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = `/phonebook/${encodeURIComponent(name)}/delete`;
        document.body.appendChild(form);
        form.submit();
    }
}
</script>
` }) %>

