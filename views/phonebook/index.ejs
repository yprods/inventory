<%- include('../layout', { title: 'ספר טלפונים', content: `
<div class="container-fluid mt-4 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold">
            <i class="fas fa-address-book text-primary"></i> ספר טלפונים
        </h1>
        <a href="/phonebook/create" class="btn btn-primary btn-lg">
            <i class="fas fa-plus-circle"></i> הוסף איש קשר
        </a>
    </div>
    
    <!-- Search and Filters -->
    <div class="card shadow-md mb-4">
        <div class="card-body">
            <form method="GET" action="/phonebook" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label"><i class="fas fa-search"></i> חיפוש</label>
                    <input type="text" name="search" class="form-control" value="<%= search %>" placeholder="שם, טלפון, אימייל...">
                </div>
                <div class="col-md-3">
                    <label class="form-label"><i class="fas fa-folder"></i> קטגוריה</label>
                    <select name="category" class="form-control">
                        <option value="">הכל</option>
                        <% categories.forEach(cat => { %>
                            <option value="<%= cat.category %>" <%= category === cat.category ? 'selected' : '' %>>
                                <%= cat.category %>
                            </option>
                        <% }); %>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label"><i class="fas fa-building"></i> מחלקה</label>
                    <select name="department" class="form-control">
                        <option value="">הכל</option>
                        <% departments.forEach(dept => { %>
                            <option value="<%= dept.department %>" <%= department === dept.department ? 'selected' : '' %>>
                                <%= dept.department %>
                            </option>
                        <% }); %>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">&nbsp;</label>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search"></i> חפש
                    </button>
                </div>
            </form>
        </div>
    </div>
    
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
    <% } %>
    
    <!-- Contacts List -->
    <% if (contacts && contacts.length > 0) { %>
        <div class="card shadow-lg">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th><i class="fas fa-user"></i> שם</th>
                                <th><i class="fas fa-building"></i> מחלקה</th>
                                <th><i class="fas fa-briefcase"></i> תפקיד</th>
                                <th><i class="fas fa-phone"></i> טלפון</th>
                                <th><i class="fas fa-mobile-alt"></i> נייד</th>
                                <th><i class="fas fa-envelope"></i> אימייל</th>
                                <th>פעולות</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% contacts.forEach(contact => { %>
                                <tr>
                                    <td><strong><%= contact.Name || contact.name || contact.f0 || 'ללא שם' %></strong></td>
                                    <td><%= contact.f2 || '-' %></td>
                                    <td><%= contact.f7 || '-' %></td>
                                    <td>
                                        <% if (contact.f3) { %>
                                            <a href="tel:<%= contact.f3 %>">
                                                <i class="fas fa-phone"></i> <%= contact.f3 %>
                                            </a>
                                        <% } else { %>
                                            -
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (contact.f4) { %>
                                            <a href="tel:<%= contact.f4 %>">
                                                <i class="fas fa-mobile-alt"></i> <%= contact.f4 %>
                                            </a>
                                        <% } else { %>
                                            -
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (contact.f5) { %>
                                            <a href="mailto:<%= contact.f5 %>">
                                                <i class="fas fa-envelope"></i> <%= contact.f5 %>
                                            </a>
                                        <% } else { %>
                                            -
                                        <% } %>
                                    </td>
                                    <td>
                                        <a href="/phonebook/<%= encodeURIComponent(contact.Name || contact.name || contact.CI_ID) %>" class="btn btn-sm btn-primary">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    <% } else { %>
        <div class="card shadow-md">
            <div class="card-body text-center py-5">
                <i class="fas fa-address-book fa-4x text-muted mb-3"></i>
                <h4>אין אנשי קשר</h4>
                <p class="text-muted">לא נמצאו אנשי קשר במערכת</p>
                <a href="/phonebook/create" class="btn btn-primary">
                    <i class="fas fa-plus"></i> הוסף איש קשר ראשון
                </a>
            </div>
        </div>
    <% } %>
</div>
` }) %>

