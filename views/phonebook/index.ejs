<%- include('../layout', { title: 'ספר טלפונים', content: `
<div class="container-fluid mt-4 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold">
            <i class="fas fa-address-book text-primary"></i> ספר טלפונים
        </h1>
    </div>
    
    <div class="card shadow-md mb-4">
        <div class="card-body">
            <form method="GET" action="/phonebook" class="d-flex gap-2">
                <input type="text" name="search" class="form-control" value="<%= search %>" placeholder="חפש איש קשר...">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-search"></i> חפש
                </button>
            </form>
        </div>
    </div>
    
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
    <% } %>
    
    <% if (contacts && contacts.length > 0) { %>
        <div class="card shadow-lg">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>שם</th>
                                <th>טלפון</th>
                                <th>נייד</th>
                                <th>אימייל</th>
                                <th>מחלקה</th>
                                <th>פעולות</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% contacts.forEach(contact => { %>
                                <tr>
                                    <td><strong><%= contact.Name || contact.name || contact.f0 || '-' %></strong></td>
                                    <td><%= contact.f3 || '-' %></td>
                                    <td><%= contact.f4 || '-' %></td>
                                    <td><%= contact.f5 || '-' %></td>
                                    <td><%= contact.f2 || '-' %></td>
                                    <td>
                                        <a href="/datablocks?search=<%= encodeURIComponent(contact.Name || contact.name) %>" class="btn btn-sm btn-primary">
                                            <i class="fas fa-eye"></i> צפה
                                        </a>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    <% } else { %>
        <div class="card shadow-lg">
            <div class="card-body text-center py-5">
                <i class="fas fa-address-book fa-4x text-muted mb-3"></i>
                <h4>אין אנשי קשר</h4>
                <p class="text-muted">לא נמצאו אנשי קשר במערכת</p>
            </div>
        </div>
    <% } %>
</div>
` }) %>

