<%- include('../layout', { title: 'מנהל מערכת', content: `
<div class="container mt-4 fade-in">
    <h1 class="display-5 fw-bold mb-4">
        <i class="fas fa-cog text-primary"></i> מנהל מערכת
    </h1>
    
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow-lg">
                <div class="card-body text-center">
                    <i class="fas fa-database fa-3x text-primary mb-3"></i>
                    <h5>מסד נתונים</h5>
                    <p class="mb-0">
                        <span class="badge bg-<%= dbConnected ? 'success' : 'danger' %>">
                            <%= dbType.toUpperCase() %> - <%= dbConnected ? 'מחובר' : 'לא מחובר' %>
                        </span>
                    </p>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card shadow-lg">
                <div class="card-body text-center">
                    <i class="fas fa-list fa-3x text-success mb-3"></i>
                    <h5>סה"כ פריטים</h5>
                    <h2 class="mb-0"><%= itemCount %></h2>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card shadow-lg">
                <div class="card-body text-center">
                    <i class="fas fa-user fa-3x text-info mb-3"></i>
                    <h5>משתמש נוכחי</h5>
                    <p class="mb-0"><%= user.name %></p>
                </div>
            </div>
        </div>
    </div>
</div>
` }) %>

