<%- include('../layout', { title: 'התראות', content: `
<div class="container-fluid mt-4 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold">
            <i class="fas fa-bell text-primary"></i> התראות
        </h1>
    </div>
    
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
    <% } %>
    
    <% if (alerts && alerts.length > 0) { %>
        <div class="card shadow-lg">
            <div class="card-body">
                <% alerts.forEach(alert => { %>
                    <div class="alert alert-<%= alert.Priority === 'high' ? 'danger' : alert.Priority === 'medium' ? 'warning' : 'info' %> mb-3">
                        <h5><%= alert.Subject || alert.Message || 'ללא נושא' %></h5>
                        <p class="mb-1"><%= alert.Message || alert.Body || '' %></p>
                        <small class="text-muted">
                            <i class="fas fa-user"></i> <%= alert.User || 'Unknown' %> | 
                            <i class="fas fa-calendar"></i> <%= new Date(alert.Timestamp || alert.SubmittedDate).toLocaleString('he-IL') %>
                        </small>
                    </div>
                <% }); %>
            </div>
        </div>
    <% } else { %>
        <div class="card shadow-lg">
            <div class="card-body text-center py-5">
                <i class="fas fa-bell fa-4x text-muted mb-3"></i>
                <h4>אין התראות</h4>
                <p class="text-muted">אין התראות חדשות</p>
            </div>
        </div>
    <% } %>
</div>
` }) %>

