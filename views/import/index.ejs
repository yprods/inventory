<%- include('../layout', { title: 'מרכז ייבוא נתונים', content: `
<div class="container-fluid mt-4 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold">
            <i class="fas fa-file-import text-primary"></i> מרכז ייבוא נתונים
        </h1>
    </div>
    
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-upload"></i> ייבוא נתונים</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">ייבוא נתונים - בפיתוח</p>
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card shadow-lg">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-file-export"></i> ייצוא נתונים</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">ייצוא נתונים - בפיתוח</p>
                </div>
            </div>
        </div>
    </div>
    
    <div class="card shadow-lg mt-4">
        <div class="card-body">
            <h5><i class="fas fa-database"></i> מצב מסד נתונים</h5>
            <p>
                <span class="badge bg-<%= dbConnected ? 'success' : 'danger' %>">
                    <%= dbType.toUpperCase() %> - <%= dbConnected ? 'מחובר' : 'לא מחובר' %>
                </span>
            </p>
        </div>
    </div>
</div>
` }) %>

