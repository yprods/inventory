<%- include('../layout', { title: 'מרכז ביקורת', content: `
<div class="container-fluid mt-4 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold">
            <i class="fas fa-clipboard-list text-primary"></i> מרכז ביקורת
        </h1>
    </div>
    
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
    <% } %>
    
    <% if (logs && logs.length > 0) { %>
        <div class="card shadow-lg">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>תאריך/שעה</th>
                                <th>משתמש</th>
                                <th>פעולה</th>
                                <th>פרטים</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% logs.forEach(log => { %>
                                <tr>
                                    <td><%= new Date(log.CreatedAt || log.Timestamp).toLocaleString('he-IL') %></td>
                                    <td><%= log.UserName || log.User || '-' %></td>
                                    <td><%= log.Action || '-' %></td>
                                    <td><%= log.Details || log.EntityName || '-' %></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    <% } else { %>
        <div class="card shadow-lg">
            <div class="card-body text-center py-5">
                <i class="fas fa-clipboard-list fa-4x text-muted mb-3"></i>
                <h4>אין רשומות ביקורת</h4>
                <p class="text-muted">אין רשומות ביקורת להצגה</p>
            </div>
        </div>
    <% } %>
</div>
` }) %>

