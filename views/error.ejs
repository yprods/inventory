<!DOCTYPE html>
<html dir="rtl" lang="he-il">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'שגיאה' %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body text-center">
                        <i class="fas fa-exclamation-triangle fa-3x text-warning mb-3"></i>
                        <h2><%= typeof title !== 'undefined' ? title : 'שגיאה' %></h2>
                        <p class="text-muted"><%= typeof message !== 'undefined' ? message : 'אירעה שגיאה' %></p>
                        <a href="/home" class="btn btn-primary">חזור לדף הבית</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

