<!DOCTYPE html>
<html dir="rtl" lang="he-il">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>צ'אט צוות - ספר מערכת</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/chat.css">
</head>
<body class="chat-page">
    <div class="chat-container">
        <div class="chat-header">
            <h4><i class="fas fa-comments"></i> צ'אט צוות</h4>
            <div id="onlineUsers" class="online-users"></div>
        </div>
        <div class="chat-messages" id="chatMessages"></div>
        <div class="chat-input">
            <div class="d-flex gap-2">
                <input type="text" id="messageInput" class="form-control" placeholder="הקלד הודעה...">
                <label for="fileInput" class="btn btn-secondary" title="צרף קובץ">
                    <i class="fas fa-paperclip"></i>
                    <input type="file" id="fileInput" style="display: none;" onchange="handleFileSelect(event)">
                </label>
                <button id="sendButton" class="btn btn-primary"><i class="fas fa-paper-plane"></i></button>
            </div>
            <div id="filePreview" class="mt-2" style="display: none;"></div>
        </div>
    </div>
    
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/chat.js"></script>
</body>
</html>

