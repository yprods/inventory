<%- include('../layout', { title: 'צ\'אט צוות', content: `
<div class="container mt-4 fade-in">
    <h1 class="display-5 fw-bold mb-4">
        <i class="fas fa-comments text-primary"></i> צ'אט צוות
    </h1>
    
    <div class="card shadow-lg">
        <div class="card-body">
            <div id="chatMessages" class="mb-3" style="height: 400px; overflow-y: auto; border: 1px solid #ddd; padding: 1rem; border-radius: 5px;">
                <p class="text-muted text-center">אין הודעות עדיין</p>
            </div>
            
            <form id="chatForm" class="d-flex gap-2">
                <input type="text" id="messageInput" class="form-control" placeholder="הקלד הודעה..." required>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-paper-plane"></i> שלח
                </button>
            </form>
        </div>
    </div>
</div>

<script>
document.getElementById('chatForm')?.addEventListener('submit', function(e) {
    e.preventDefault();
    const input = document.getElementById('messageInput');
    const message = input.value.trim();
    if (message) {
        const messagesDiv = document.getElementById('chatMessages');
        const messageEl = document.createElement('div');
        messageEl.className = 'mb-2';
        messageEl.innerHTML = `<strong><%= user.name %>:</strong> ${message}`;
        messagesDiv.appendChild(messageEl);
        messagesDiv.scrollTop = messagesDiv.scrollHeight;
        input.value = '';
    }
});
</script>
` }) %>

