<%- include('../layout', { title: 'חנות אפליקציות', content: `
<div class="container-fluid mt-4 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold">
            <i class="fas fa-store text-primary"></i> חנות אפליקציות
        </h1>
    </div>
    
    <div class="card shadow-md mb-4">
        <div class="card-body">
            <form method="GET" action="/appstore" class="d-flex gap-2">
                <input type="text" name="search" class="form-control" value="<%= search %>" placeholder="חפש אפליקציה...">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-search"></i> חפש
                </button>
            </form>
        </div>
    </div>
    
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
    <% } %>
    
    <% if (apps && apps.length > 0) { %>
        <div class="row g-4">
            <% apps.forEach(app => { %>
                <div class="col-md-4">
                    <div class="card shadow-md h-100">
                        <div class="card-body">
                            <h5 class="card-title"><%= app.Name || app.name || app.f0 || 'ללא שם' %></h5>
                            <p class="text-muted"><%= app.f1 || 'ללא תיאור' %></p>
                            <a href="/datablocks?search=<%= encodeURIComponent(app.Name || app.name) %>" class="btn btn-primary">
                                <i class="fas fa-eye"></i> צפה בפרטים
                            </a>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } else { %>
        <div class="card shadow-lg">
            <div class="card-body text-center py-5">
                <i class="fas fa-store fa-4x text-muted mb-3"></i>
                <h4>אין אפליקציות</h4>
                <p class="text-muted">לא נמצאו אפליקציות במערכת</p>
            </div>
        </div>
    <% } %>
</div>
` }) %>

