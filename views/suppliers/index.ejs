<%- include('../layout', { title: 'ספקים', content: `
<div class="container-fluid mt-4 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold">
            <i class="fas fa-truck text-primary"></i> ספקים
        </h1>
    </div>
    
    <div class="card shadow-md mb-4">
        <div class="card-body">
            <form method="GET" action="/suppliers" class="d-flex gap-2">
                <input type="text" name="search" class="form-control" value="<%= search %>" placeholder="חפש ספק...">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-search"></i> חפש
                </button>
            </form>
        </div>
    </div>
    
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
    <% } %>
    
    <% if (suppliers && suppliers.length > 0) { %>
        <div class="row g-4">
            <% suppliers.forEach(supplier => { %>
                <div class="col-md-4">
                    <div class="card shadow-md h-100">
                        <div class="card-body">
                            <h5 class="card-title"><%= supplier.Name || supplier.name || supplier.f0 || 'ללא שם' %></h5>
                            <p class="text-muted"><%= supplier.f1 || 'ללא קטגוריה' %></p>
                            <p><i class="fas fa-phone"></i> <%= supplier.f4 || '-' %></p>
                            <p><i class="fas fa-envelope"></i> <%= supplier.f5 || '-' %></p>
                            <a href="/datablocks?search=<%= encodeURIComponent(supplier.Name || supplier.name) %>" class="btn btn-primary">
                                <i class="fas fa-eye"></i> צפה בפרטים
                            </a>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } else { %>
        <div class="card shadow-lg">
            <div class="card-body text-center py-5">
                <i class="fas fa-truck fa-4x text-muted mb-3"></i>
                <h4>אין ספקים</h4>
                <p class="text-muted">לא נמצאו ספקים במערכת</p>
            </div>
        </div>
    <% } %>
</div>
` }) %>

