<%- include('../layout', { title: 'הוספת ספק חדש', content: `
<div class="container mt-4 fade-in">
    <h1 class="display-5 fw-bold mb-4">
        <i class="fas fa-truck text-primary"></i> הוספת ספק חדש
    </h1>
    
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
    <% } %>
    
    <div class="card shadow-lg">
        <div class="card-body p-4">
            <form method="POST" action="/suppliers/create">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><i class="fas fa-tag"></i> שם הספק *</label>
                        <input type="text" name="name" class="form-control" required autofocus>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><i class="fas fa-folder"></i> קטגוריה</label>
                        <input type="text" name="category" class="form-control" placeholder="IT, Office Supplies, Services...">
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><i class="fas fa-user"></i> איש קשר</label>
                        <input type="text" name="contactPerson" class="form-control">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><i class="fas fa-info-circle"></i> סטטוס</label>
                        <select name="status" class="form-control">
                            <option value="Active">פעיל</option>
                            <option value="Inactive">לא פעיל</option>
                        </select>
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><i class="fas fa-phone"></i> טלפון</label>
                        <input type="tel" name="phone" class="form-control">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><i class="fas fa-envelope"></i> אימייל</label>
                        <input type="email" name="email" class="form-control">
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><i class="fas fa-map-marker-alt"></i> כתובת</label>
                        <textarea name="address" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><i class="fas fa-globe"></i> אתר אינטרנט</label>
                        <input type="url" name="website" class="form-control" placeholder="https://...">
                    </div>
                </div>
                
                <div class="mb-3">
                    <label class="form-label"><i class="fas fa-id-card"></i> ח.פ./מס' עוסק</label>
                    <input type="text" name="taxId" class="form-control">
                </div>
                
                <div class="mb-3">
                    <label class="form-label"><i class="fas fa-align-right"></i> הערות</label>
                    <textarea name="notes" class="form-control" rows="4"></textarea>
                </div>
                
                <div class="mt-4">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="fas fa-save"></i> שמור ספק
                    </button>
                    <a href="/suppliers" class="btn btn-secondary btn-lg">ביטול</a>
                </div>
            </form>
        </div>
    </div>
</div>
` }) %>

